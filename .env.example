# Claude. Get a key at https://console.anthropic.com
# With a key set, Claude writes the script and reads each reference's look; without one Reel runs on the
# scripted director, which is deterministic and offline.
ANTHROPIC_API_KEY=
REEL_MODEL=claude-opus-5-5

# Force a director: anthropic, or scripted.
# REEL_LLM=scripted

# Limits.
# REEL_MAX_REFERENCE_SECONDS=300
# REEL_MAX_REFERENCES=5
# REEL_MAX_UPLOAD_MB=200

# Where projects, media and renders live.
# REEL_DATA_DIR=./data

# Chrome for rendering and page captures, if it isn't in a standard place.
# CHROME_PATH=/usr/bin/google-chrome
